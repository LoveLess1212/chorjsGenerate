    <bpmn:textAnnotation id="TextAnnotation1wdod8j">
      <bpmn:text>Deliver the exact vehicle class the renter requested in booking</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1wsfahs" sourceRef="ChoreographyTask1y65w5o" targetRef="TextAnnotation1wdod8j" />
    <bpmn:textAnnotation id="TextAnnotation0kzzfji">
      <bpmn:text>Provide an upgraded model within the same segment in a neutral color</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association014u5td" sourceRef="ChoreographyTask111r9fp" targetRef="TextAnnotation0kzzfji" />
    <bpmn:textAnnotation id="TextAnnotation06nk93e">
      <bpmn:text>Provide a car of comparable class in neutral color; waive all insurance costs from Trusted Insurer; offer free accessories (e.g., child safety seats)</bpmn:text>
    </bpmn:textAnnotation>
