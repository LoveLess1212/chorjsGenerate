    <bpmn:textAnnotation id="TextAnnotation0nyh7g5">
      <bpmn:text>≡ ∃ro ∈ Jade, t ∈ Tourist : booked(t, ro) ∧ BalconyWithSeaView(ro)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1fpuqig" sourceRef="Event1gpdiw6" targetRef="TextAnnotation0nyh7g5" />
    <bpmn:textAnnotation id="TextAnnotation09ttq7z">
      <bpmn:text>≡ ∃ar ∈ Jade, t ∈ Tourist : (LuxuryInterior(ar) ∨ KingSizeDoubleBed(ar)) ∧ CheckIn(t, ar)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association16hyu1m" sourceRef="ChoreographyTask0q6m2nj" targetRef="TextAnnotation09ttq7z" />
    <bpmn:textAnnotation id="TextAnnotation19v2tjw">
      <bpmn:text>≡ ∃spa ∈ Service, ar ∈ Jade, t ∈ Tourist : FreeAccess(ar, spa) ∧ CheckIn(t, ar)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1q1mtdx" sourceRef="ChoreographyTask00knroo" targetRef="TextAnnotation19v2tjw" />
    <bpmn:textAnnotation id="TextAnnotation08skmp9">
      <bpmn:text>≡ ∃ro ∈ Jade, t ∈ Tourist, spa ∈ Service : booked(t, ro) ∧ CheckOut(t, ro) ∧ Discount50Percent(t, ro)</bpmn:text>
    </bpmn:textAnnotation>
