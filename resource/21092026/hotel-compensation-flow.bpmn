    <bpmn:textAnnotation id="TextAnnotation1fnwl5n">
      <bpmn:text>≡ ∃ro ∈ Jade, t ∈ Tourist : booked(t, ro) ∧ BalconyWithSeaView(ro)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1xwq5bb" sourceRef="Event1ntvtvr" targetRef="TextAnnotation1fnwl5n" />
    <bpmn:textAnnotation id="TextAnnotation1pco71r">
      <bpmn:text>≡ ∃ar ∈ Jade, t ∈ Tourist : (LuxuryInterior(ar) ∨ KingSizeDoubleBed(ar)) ∧ CheckIn(t, ar)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association078gf51" sourceRef="ChoreographyTask08wr415" targetRef="TextAnnotation1pco71r" />
    <bpmn:textAnnotation id="TextAnnotation088t6tt">
      <bpmn:text>≡ ∃spa ∈ Service, ar ∈ Jade, t ∈ Tourist : FreeAccess(ar, spa) ∧ CheckIn(t, ar)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association0tlh6sx" sourceRef="ChoreographyTask0znklan" targetRef="TextAnnotation088t6tt" />
    <bpmn:textAnnotation id="TextAnnotation06kdz0y">
      <bpmn:text>≡ ∃ro ∈ Jade, t ∈ Tourist, spa ∈ Service : booked(t, ro) ∧ CheckOut(t, ro) ∧ Discount50Percent(t, ro)</bpmn:text>
    </bpmn:textAnnotation>
