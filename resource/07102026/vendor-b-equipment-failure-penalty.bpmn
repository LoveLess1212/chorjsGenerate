    <bpmn:textAnnotation id="TextAnnotation1gd9ott">
      <bpmn:text>Refund of rental cost plus operational failure fee</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1f4x1dh" sourceRef="ChoreographyTask1pb90lp" targetRef="TextAnnotation1gd9ott" />
