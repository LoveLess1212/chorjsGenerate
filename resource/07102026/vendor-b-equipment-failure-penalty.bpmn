    <bpmn:textAnnotation id="TextAnnotation0dt8b72">
      <bpmn:text>During wedding event, audio-visual or lighting failure by Vendor-B</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association0h8s34t" sourceRef="Event1blrotw" targetRef="TextAnnotation0dt8b72" />
    <bpmn:textAnnotation id="TextAnnotation14784z4">
      <bpmn:text>Replacement must be provided within 90 minutes</bpmn:text>
    </bpmn:textAnnotation>
