    <bpmn:textAnnotation id="TextAnnotation00jz8yp">
      <bpmn:text>Prior to the wedding event</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association18vewe0" sourceRef="Event00vkgee" targetRef="TextAnnotation00jz8yp" />
    <bpmn:textAnnotation id="TextAnnotation0jkdz7m">
      <bpmn:text>Delay over 1 hour but event not disrupted; 25% rental fee credit due to Couple within 7 business days</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1rpihlf" sourceRef="ChoreographyTask0suth55" targetRef="TextAnnotation0jkdz7m" />
    <bpmn:textAnnotation id="TextAnnotation0k896ai">
      <bpmn:text>Delay disrupts event by over 30 minutes; 50% total contract refund to Couple</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association0kwaj1n" sourceRef="ChoreographyTask0uy4nfo" targetRef="TextAnnotation0k896ai" />
    <bpmn:textAnnotation id="TextAnnotation0iuohr4">
      <bpmn:text>During the wedding event</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1e4kmm9" sourceRef="Event1fpgp5m" targetRef="TextAnnotation0iuohr4" />
    <bpmn:textAnnotation id="TextAnnotation1ddiml3">
      <bpmn:text>Defective audio-visual or lighting equipment; functional replacement due within 90 minutes at event site</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association0v8um7i" sourceRef="ChoreographyTask0dsvsm2" targetRef="TextAnnotation1ddiml3" />
    <bpmn:textAnnotation id="TextAnnotation1klhalj">
      <bpmn:text>Failure to provide replacement; 80% refund plus $300 operational failure fee payable to Couple</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association0oymbt9" sourceRef="ChoreographyTask0snm6b5" targetRef="TextAnnotation1klhalj" />
