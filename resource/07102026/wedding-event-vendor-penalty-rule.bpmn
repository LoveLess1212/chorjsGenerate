  <bpmn:choreography id="Choreography1nrweg6" name="Wedding Event Vendor Penalty Rule">
    <bpmn:participant id="Participant040ciy6" name="Couple" />
    <bpmn:participant id="Participant0i773od" name="Vendor-A" />
    <bpmn:participant id="Participant02qiyqj" name="Vendor-B" />
