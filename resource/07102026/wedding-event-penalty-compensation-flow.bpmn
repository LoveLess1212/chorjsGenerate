    <bpmn:textAnnotation id="TextAnnotation01q02ne">
      <bpmn:text>Before wedding event</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association18ycavu" sourceRef="Event0dcjrrl" targetRef="TextAnnotation01q02ne" />
    <bpmn:textAnnotation id="TextAnnotation0hl7p6y">
      <bpmn:text>If Vendor-A delay &gt;1 hour but no disruption; credit to Couple within 7 business days</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1wqj945" sourceRef="ChoreographyTask0mqispz" targetRef="TextAnnotation0hl7p6y" />
    <bpmn:textAnnotation id="TextAnnotation0uxu93o">
      <bpmn:text>If delay disrupts event schedule by more than 30 minutes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1cw3qjg" sourceRef="ChoreographyTask19st3xj" targetRef="TextAnnotation0uxu93o" />
    <bpmn:textAnnotation id="TextAnnotation10w17by">
      <bpmn:text>During wedding event</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1153e4q" sourceRef="Event15twrll" targetRef="TextAnnotation10w17by" />
    <bpmn:textAnnotation id="TextAnnotation0rwyrhf">
      <bpmn:text>Replace faulty apparatus within 90 minutes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association0qvp06u" sourceRef="ChoreographyTask08atkv3" targetRef="TextAnnotation0rwyrhf" />
    <bpmn:textAnnotation id="TextAnnotation1c2yk60">
      <bpmn:text>Refund and fee to Couple upon failure to replace</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association068vvv6" sourceRef="ChoreographyTask0367exa" targetRef="TextAnnotation1c2yk60" />
