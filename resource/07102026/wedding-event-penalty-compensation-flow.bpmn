  <bpmn:choreography id="Choreography0fnc7es" name="Wedding Event Penalty Compensation Flow">
    <bpmn:participant id="Participant1wrhnmy" name="Couple" />
    <bpmn:participant id="Participant1ucqgdc" name="Vendor-A" />
    <bpmn:participant id="Participant1al9sy0" name="Vendor-B" />
