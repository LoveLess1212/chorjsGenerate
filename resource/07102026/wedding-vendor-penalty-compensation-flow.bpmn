    <bpmn:textAnnotation id="TextAnnotation0ffjd3c">
      <bpmn:text>If furniture &amp; tenting delivery delayed more than 1 hour but event not disrupted; within 7 business days</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association07phrvq" sourceRef="ChoreographyTask12bm13k" targetRef="TextAnnotation0ffjd3c" />
    <bpmn:textAnnotation id="TextAnnotation0yf17gp">
      <bpmn:text>If delay disrupts wedding event schedule by more than 30 minutes; total contract value</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1cunj5d" sourceRef="ChoreographyTask0i0i3dt" targetRef="TextAnnotation0yf17gp" />
    <bpmn:textAnnotation id="TextAnnotation0835v8i">
      <bpmn:text>Event scheduled and compensated successfully</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association0jzt2cq" sourceRef="Event0gp9e0y" targetRef="TextAnnotation0835v8i" />
    <bpmn:textAnnotation id="TextAnnotation03siqdh">
      <bpmn:text>No rental credit or refund provided by Vendor-A</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1j8n77v" sourceRef="Event1pk0wkr" targetRef="TextAnnotation03siqdh" />
    <bpmn:textAnnotation id="TextAnnotation1qmg1xk">
      <bpmn:text>If audio-visual or lighting fails during event; replacement within 90 minutes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association0npttym" sourceRef="ChoreographyTask0l18o5x" targetRef="TextAnnotation1qmg1xk" />
    <bpmn:textAnnotation id="TextAnnotation1sqltu2">
      <bpmn:text>If replacement not available within 90 minutes; refund rental cost and pay $300 failure fee</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association0k1kupd" sourceRef="ChoreographyTask0cook37" targetRef="TextAnnotation1sqltu2" />
    <bpmn:textAnnotation id="TextAnnotation1dgtep2">
      <bpmn:text>No replacement or compensation provided</bpmn:text>
    </bpmn:textAnnotation>
