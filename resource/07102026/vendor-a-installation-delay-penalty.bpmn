    <bpmn:messageFlow id="MessageFlow0pqv5np" sourceRef="Participant1weayoz" targetRef="Participant1f8wug9" messageRef="Message0vp65b2" />
    <bpmn:messageFlow id="MessageFlow07da9uq" sourceRef="Participant1weayoz" targetRef="Participant1f8wug9" messageRef="Message0jn5wya" />
    <bpmn:textAnnotation id="TextAnnotation17kcgrr">
      <bpmn:text>Delay of furniture &amp; tenting installation by Vendor-A prior to wedding event</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1olpq0q" sourceRef="Event0nciib9" targetRef="TextAnnotation17kcgrr" />
    <bpmn:textAnnotation id="TextAnnotation1hceweo">
      <bpmn:text>If delay is more than 1 hour without disrupting event</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1bf7e5n" sourceRef="ChoreographyTask0lsc5aq" targetRef="TextAnnotation1hceweo" />
    <bpmn:textAnnotation id="TextAnnotation08a2gb2">
      <bpmn:text>If delay disrupts wedding event schedule by more than 30 minutes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association0sxjwi7" sourceRef="ChoreographyTask06bc1i8" targetRef="TextAnnotation08a2gb2" />
