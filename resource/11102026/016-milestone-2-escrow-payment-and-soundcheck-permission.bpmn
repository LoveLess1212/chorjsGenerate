    <bpmn:sequenceFlow id="Flow0gexgoa" sourceRef="ChoreographyTask09i7vmz" targetRef="Event0gb3bl6" />
    <bpmn:endEvent id="Event0gb3bl6" name="Milestone-2 Payment Released and Soundcheck Permitted">
      <bpmn:incoming>Flow0gexgoa</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition057h91m" />
    </bpmn:endEvent>
