    <bpmn:sequenceFlow id="Flow1iwqt03" sourceRef="ChoreographyTask00hta2l" targetRef="Gateway1wc64u2" />
    <bpmn:sequenceFlow id="Flow1vwldca" name="yes" sourceRef="Gateway1wc64u2" targetRef="ChoreographyTask09i7vmz" />
    <bpmn:sequenceFlow id="Flow1gfqpjh" name="no" sourceRef="Gateway1wc64u2" targetRef="Event1w4mvth" />
    <bpmn:exclusiveGateway id="Gateway1wc64u2" name="Are both required documents submitted?">
      <bpmn:incoming>Flow1iwqt03</bpmn:incoming>
