  <bpmn:message id="Message0qfiotv" />
  <bpmn:choreography id="Choreography1iz8qsj" name="Milestone-2 Escrow Payment and Soundcheck Permission">
    <bpmn:participant id="Participant160r4vq" name="Producer" />
    <bpmn:participant id="Participant0p0u3et" name="Vendor-A" />
    <bpmn:participant id="Participant0zgkd3u" name="Vendor-B" />
    <bpmn:messageFlow id="MessageFlow00qvd3d" sourceRef="Participant160r4vq" targetRef="Participant0p0u3et" messageRef="Message1f4y26o" />
    <bpmn:messageFlow id="MessageFlow01zz6es" sourceRef="Participant160r4vq" messageRef="Message0qfiotv" />
    <bpmn:textAnnotation id="TextAnnotation1wnxai9">
      <bpmn:text>Both Vendor-A has submitted structural certificate and Vendor-B has submitted electrical safety report</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1e2akqe" sourceRef="Event0uxam0n" targetRef="TextAnnotation1wnxai9" />
    <bpmn:textAnnotation id="TextAnnotation1miyplc">
      <bpmn:text>Payment of $50,000 split equally between Vendor-A and Vendor-B</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1smb8pr" sourceRef="ChoreographyTask00hta2l" targetRef="TextAnnotation1miyplc" />
    <bpmn:textAnnotation id="TextAnnotation1c5ad3m">
      <bpmn:text>Neither vendor receives payment; rehearsals cannot proceed</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1xn3qjf" sourceRef="Event1w4mvth" targetRef="TextAnnotation1c5ad3m" />
    <bpmn:startEvent id="Event0uxam0n" name="Milestone-2 Conditions Met">
      <bpmn:outgoing>Flow1wzvtb9</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="ConditionalEventDefinition1ou0gph">
        <bpmn:condition xsi:type="bpmn:tFormalExpression" />
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow1wzvtb9" sourceRef="Event0uxam0n" targetRef="ChoreographyTask00hta2l" />
    <bpmn:choreographyTask id="ChoreographyTask00hta2l" name="Release Milestone-2 Escrow Payment" initiatingParticipantRef="Participant160r4vq">
      <bpmn:incoming>Flow1wzvtb9</bpmn:incoming>
      <bpmn:outgoing>Flow1iwqt03</bpmn:outgoing>
