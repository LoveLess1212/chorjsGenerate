    <bpmn:textAnnotation id="TextAnnotation1g9s5h5">
      <bpmn:text>Prior to wedding event; must not delay more than 1 hour or disrupt schedule</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association0zvmu3h" sourceRef="ChoreographyTask0b75w8k" targetRef="TextAnnotation1g9s5h5" />
    <bpmn:textAnnotation id="TextAnnotation1totnig">
      <bpmn:text>Delay &gt; 1 hour but no disruption to event; payable within 7 business days</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1jxbxad" sourceRef="ChoreographyTask0ylw1x8" targetRef="TextAnnotation1totnig" />
    <bpmn:textAnnotation id="TextAnnotation1pjr7go">
      <bpmn:text>Delay directly disrupts event schedule by more than 30 minutes</bpmn:text>
    </bpmn:textAnnotation>
