  <bpmn:choreography id="Choreography1pmpjxv" name="Remedy for failed audio-visual or lighting apparatus during wedding event">
    <bpmn:participant id="Participant0008hz1" name="Vendor-B" />
    <bpmn:participant id="Participant1g6fkya" name="Couple" />
    <bpmn:messageFlow id="MessageFlow0679tyi" sourceRef="Participant0008hz1" targetRef="Participant1g6fkya" messageRef="Message1lfoglk" />
    <bpmn:messageFlow id="MessageFlow02da1vj" sourceRef="Participant0008hz1" targetRef="Participant1g6fkya" messageRef="Message1lltx3k" />
    <bpmn:textAnnotation id="TextAnnotation18ah3mp">
      <bpmn:text>During the wedding event just before the last hours when guests eat and socialize</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association0v5xrlv" sourceRef="Event1c3sqsm" targetRef="TextAnnotation18ah3mp" />
    <bpmn:textAnnotation id="TextAnnotation0j7m079">
      <bpmn:text>Replacement must be provided within 90 minutes on-site</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association1nhqaae" sourceRef="ChoreographyTask0sxllek" targetRef="TextAnnotation0j7m079" />
    <bpmn:textAnnotation id="TextAnnotation0ug57wq">
      <bpmn:text>Payment to the couple for failure to remedy on-site</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association0lg0dib" sourceRef="ChoreographyTask1ibzuyb" targetRef="TextAnnotation0ug57wq" />
    <bpmn:startEvent id="Event1c3sqsm" name="Audio-visual or lighting failure detected">
      <bpmn:outgoing>Flow1kg1mf4</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="ConditionalEventDefinition02904ik">
        <bpmn:condition xsi:type="bpmn:tFormalExpression" />
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow1kg1mf4" sourceRef="Event1c3sqsm" targetRef="ChoreographyTask0sxllek" />
